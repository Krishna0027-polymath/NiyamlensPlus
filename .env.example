# Copy this file to .env.local for local development. Do not commit .env.local.
# `npm run dev` starts and monitors PaddleX at this default local endpoint.
LOCAL_PADDLEOCR_URL='http://127.0.0.1:8080/ocr'

# Optional: enables retailer price lookup. Never commit a real key here.
TAVILY_API_KEY='replace_with_your_tavily_api_key'
