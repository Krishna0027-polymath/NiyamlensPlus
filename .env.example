# Copy this file to .env.local for local development. Do not commit .env.local.
# `npm run dev` starts and monitors PaddleX at this default local endpoint.
LOCAL_PADDLEOCR_URL='http://127.0.0.1:8080/ocr'

# Strongly recommended whenever the app is reachable by other devices. When
# both values are set, the local server requires HTTP Basic authentication.
# NIYAMLENS_AUTH_USER='inspector'
# NIYAMLENS_AUTH_PASSWORD='replace_with_a_long_random_password'

# Optional local case-store directory. The default is .niyamlens-data/.
# Use a persistent mounted directory in a container deployment.
NIYAMLENS_DATA_DIR='.niyamlens-data'

# Optional: Bhashini Hindi narration. Obtain an inference key from the Bhashini
# developer portal and keep it server-side. If omitted or unavailable, Saathi
# automatically uses the browser's Hindi speech synthesis.
# BHASHINI_INFERENCE_API_KEY='replace_with_your_bhashini_inference_key'
# BHASHINI_TTS_SERVICE_ID='Bhashini/IITM/TTS'
# BHASHINI_TTS_GENDER='female'
# BHASHINI_TTS_URL='https://dhruva-api.bhashini.gov.in/services/inference/pipeline'
# BHASHINI_AUTH_HEADER='Authorization'

# Optional: Azure Speech F0 English narration. If omitted or unavailable,
# Saathi automatically uses the browser's English speech synthesis.
# AZURE_SPEECH_KEY='replace_with_your_azure_speech_key'
# AZURE_SPEECH_REGION='centralindia'

# Optional English voice override.
# AZURE_SPEECH_EN_VOICE='en-IN-AashiNeural'
